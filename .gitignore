.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# Raw snapshots are immutable but NOT committed (size + licence).
# Manifests ARE committed: they are the provenance record.
data/raw/**
# `!...manifest.json` alone never matches: `data/raw/**` excludes the directories
# too, so git stops descending before it ever sees the manifest. Re-including the
# directories is what lets the negation below apply.
!data/raw/**/
!data/raw/**/manifest.json
!data/raw/.gitkeep

data/staging/**
data/external/**
!data/**/.gitkeep

# data/standardized IS committed (1.6 MB of Parquet). It is derived, but it is
# what `make warehouse` loads, so committing it is what lets a fresh clone build
# the warehouse and serve the dashboard without re-fetching 52 MB of source PDFs
# from a dozen government portals - several of which are slow, form-driven, or
# liable to move. The raw snapshots remain the system of record; every row here
# still carries its source_id, snapshot_file and ingested_at.

# Profiling reports ARE committed (they are evidence, see docs/profiling/)

# generated CA bundle cache (rebuilt from certifi + the committed intermediate)
config/certs/.bundle_*.pem

# DuckDB warehouse is rebuildable from data/standardized via `make warehouse`
db/lmis.duckdb
